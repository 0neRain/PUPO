# Copia questo file in .env (backend/.env) e inserisci la tua chiave API.
# Non committare mai il file .env: contiene un segreto.
OPENAI_API_KEY=sk-...

# Modello usato per le chat del Pupo, del giudice e per creare il programma.
PUPO_MODEL=gpt-4o-mini

# Modello usato per trascrivere le registrazioni delle lezioni.
PUPO_TRANSCRIBE_MODEL=whisper-1

# Cartella dove vengono salvati i database di ogni studente/materia
# (data/<studente>/<materia>/reference.db e learning.db).
PUPO_DATA_DIR=data
